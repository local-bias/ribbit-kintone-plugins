{
  "name": "calendar",
  "version": "0.1.0",
  "author": "ribbit",
  "license": "MIT",
  "scripts": {
    "init": "plugin init && plugin genkey",
    "build:css-desktop": "pnpm dlx @tailwindcss/cli -i ./src/styles/desktop.css -o ./.plugin/contents/desktop.css --minify",
    "build:css-config": "pnpm dlx @tailwindcss/cli -i ./src/styles/config.css -o ./.plugin/contents/config.css --minify",
    "build:js": "plugin build",
    "build": "pnpm run build:js && concurrently \"pnpm:build:css-*\" && plugin zip",
    "standalone": "pnpm run build:js && concurrently \"pnpm:build:css-*\" && plugin zip --env standalone",
    "dev:js": "plugin dev --cert-dir ~/config/cert",
    "dev:css-desktop": "pnpm dlx @tailwindcss/cli -i ./src/styles/desktop.css -o ./.plugin/dev/desktop.css --watch",
    "dev:css-config": "pnpm dlx @tailwindcss/cli -i ./src/styles/config.css -o ./.plugin/dev/config.css --watch",
    "dev": "concurrently \"pnpm:dev:*\"",
    "test": "vitest run"
  },
  "browser": {
    "path": false
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/bootstrap5": "^6.1.21",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/rrule": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@kintone/rest-api-client": "^6.1.1",
    "@konomi-app/kintone-utilities": "catalog:",
    "@konomi-app/kintone-utilities-react": "catalog:",
    "@konomi-app/ui-react": "catalog:",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-date-pickers": "^8.25.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hamburger-react": "^2.5.2",
    "immer": "^11.1.3",
    "jotai": "catalog:",
    "jotai-eager": "catalog:",
    "jotai-optics": "catalog:",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.6",
    "notistack": "^3.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "remeda": "^2.39.0",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@kintone/dts-gen": "^9.0.1",
    "@kintone/plugin-uploader": "^10.0.0",
    "@konomi-app/k2": "catalog:",
    "@konomi-app/prettier-config": "^1.1.2",
    "@repo/tailwindcss": "workspace:*",
    "@types/luxon": "^3.7.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "tailwindcss": "catalog:",
    "ts-loader": "^9.5.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@konomi-app/prettier-config"
}
