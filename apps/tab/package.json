{
  "name": "tab",
  "version": "1.0.0",
  "author": "ribbit",
  "license": "MIT",
  "scripts": {
    "init": "plugin init && plugin genkey",
    "build:css-desktop": "pnpm dlx @tailwindcss/cli -i ./src/styles/desktop.css -o ./.plugin/contents/desktop.css --minify",
    "build:css-config": "pnpm dlx @tailwindcss/cli -i ./src/styles/config.css -o ./.plugin/contents/config.css --minify",
    "build:js": "plugin build",
    "build": "pnpm run build:js && concurrently \"pnpm:build:css-*\" && plugin zip",
    "standalone": "pnpm run build && plugin zip --env standalone",
    "dev:js": "plugin dev --cert-dir ~/config/cert",
    "dev:css-desktop": "pnpm dlx @tailwindcss/cli -i ./src/styles/desktop.css -o ./.plugin/dev/desktop.css --watch",
    "dev:css-config": "pnpm dlx @tailwindcss/cli -i ./src/styles/config.css -o ./.plugin/dev/config.css --watch",
    "dev": "concurrently \"pnpm:dev:*\"",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "browser": {
    "path": false
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@konomi-app/kintone-utilities": "catalog:",
    "@konomi-app/kintone-utilities-jotai": "catalog:",
    "@konomi-app/kintone-utilities-react": "catalog:",
    "@konomi-app/ui": "catalog:",
    "@konomi-app/ui-react": "catalog:",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@repo/constants": "workspace:*",
    "@repo/jotai": "workspace:*",
    "@repo/plugin": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "clsx": "^2.1.1",
    "immer": "^11.1.4",
    "jotai": "catalog:",
    "jotai-optics": "catalog:",
    "nanoid": "^5.1.7",
    "notistack": "^3.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.1",
    "remeda": "^2.33.6",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@kintone/dts-gen": "^9.0.2",
    "@konomi-app/k2": "catalog:",
    "@repo/tailwindcss": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "tailwindcss": "catalog:",
    "ts-loader": "^9.5.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
